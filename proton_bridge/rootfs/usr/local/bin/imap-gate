#!/usr/bin/env bash
# socat SYSTEM: helper. Forwards IMAP to Bridge only if the peer IP is in $IMAP_ALLOW
# and not in $IMAP_DENY (deny is checked first; empty by default). Allowed connections go
# through starttls-guard, which refuses LOGIN/AUTHENTICATE before STARTTLS (Bridge
# v3.27.1 would otherwise accept cleartext credentials; Pi test 2026-10-30 check b).
set -u
valid_ip() {
  [[ $1 =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  local o; for o in "${BASH_REMATCH[@]:1}"; do (( 10#$o <= 255 )) || return 1; done
}
ip2int() { local IFS=.; set -- $1; echo $(( (10#$1<<24)+(10#$2<<16)+(10#$3<<8)+10#$4 )); }
in_list() { # $1=int ip, $2=list of CIDRs
  local c net bits mask
  for c in $2; do
    net=${c%/*}; bits=${c#*/}; [ "$bits" = "$c" ] && bits=32
    valid_ip "$net" && [[ $bits =~ ^[0-9]{1,2}$ ]] && (( bits <= 32 )) || continue
    mask=$(( bits==0 ? 0 : (0xFFFFFFFF << (32-bits)) & 0xFFFFFFFF ))
    (( ($1 & mask) == ($(ip2int "$net") & mask) )) && return 0
  done
  return 1
}
peer=${SOCAT_PEERADDR:-}; peer=${peer#::ffff:}
if valid_ip "$peer"; then
  p=$(ip2int "$peer")
  if ! in_list "$p" "${IMAP_DENY:-}" && in_list "$p" "${IMAP_ALLOW:-}"; then
    exec /usr/local/bin/starttls-guard 127.0.0.1:1143
  fi
fi
# Rate-limited refusal log: at most one line per 60 s, with the count suppressed since.
STAMP=/tmp/imap-gate.last; CNT=/tmp/imap-gate.count
now=$(date +%s); last=$(cat "$STAMP" 2>/dev/null || echo 0)
if (( now - last >= 60 )); then
  n=$(cat "$CNT" 2>/dev/null || echo 0)
  echo "[proton-bridge] imap-gate: refused ${peer:-unknown}${n:+ (+$n more refused in last window)}" >&2
  echo "$now" > "$STAMP"; echo 0 > "$CNT"
else
  echo $(( $(cat "$CNT" 2>/dev/null || echo 0) + 1 )) > "$CNT"
fi
exit 0
