{
  "$schema_note": "BRYSON-UI-4 Charcoal design tokens. Single source of truth. Edit here, then run: python3 shared/design/build.py",
  "name": "BRYSON-UI-4 Charcoal",
  "version": "4.2.0",
  "approved": "Bryson 2026-11-25 23:34 ET: Tesla design with charcoal backgrounds and brighter text (no pure-black pages). Base: BRYSON-UI-4 (2026-11-10).",
  "rules": [
    "No pure-black page backgrounds.",
    "No orange or amber anywhere (error/unavailable uses danger).",
    "Accent #3E6AE1 for fills, toggles, sliders, selection bars; use #6D8EE8 (accent-text / link) for blue text, links, tabs and icons on surfaces (HA primary-color).",
    "Real bulb colors (RGB/color-temp lights) are shown as-is; tokens never override them.",
    "24-hour time everywhere.",
    "WCAG AA: body text >= 4.5:1 on its surface, UI components >= 3:1."
  ],
  "color": {
    "page": "#1a1a1a",
    "surface": "#2a2a2a",
    "surface-raised": "#393939",
    "input": "#333333",
    "input-disabled": "#242424",
    "border": "#3a3a3a",
    "border-strong": "#5a5a5a",
    "text": "#f5f5f5",
    "text-secondary": "#c8c8c8",
    "text-disabled": "#8a8a8a",
    "text-on-accent": "#ffffff",
    "accent": "#3E6AE1",
    "accent-hover": "#5B84F0",
    "accent-pressed": "#2A4CB8",
    "accent-text": "#6D8EE8",
    "link": "#6D8EE8",
    "accent-soft": "rgba(62, 106, 225, 0.16)",
    "focus-ring": "#6D8EE8",
    "success": "#3ddc84",
    "danger": "#ff5d73",
    "danger-soft": "rgba(255, 93, 115, 0.16)",
    "info": "#9ec4ff",
    "heat": "#ff6b9a",
    "cool": "#5aa2ff",
    "dry": "#2ee6c7",
    "off": "#8a8a8a",
    "category": {
      "blue": "#5aa2ff",
      "green": "#3ddc84",
