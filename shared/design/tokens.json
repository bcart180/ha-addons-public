    "primary-scale": {
      "05": "#070d1d",
      "10": "#0c1632",
      "20": "#11214a",
      "30": "#153384",
      "40": "#3E6AE1",
      "50": "#6084e6",
      "60": "#7b99ea",
      "70": "#9eb4f0",
      "80": "#c1cff5",
      "90": "#dce4fa",
      "95": "#edf1fc"
