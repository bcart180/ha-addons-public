name: Spelling
version: "0.1.0"
slug: spelling
description: A child's spelling practice page in the HA sidebar, served read-only from /share/spelling
url: https://github.com/bcart180/ha-addons-public/tree/main/spelling
arch:
  - aarch64
  - amd64
init: false
startup: application
boot: auto
# Sidebar panel behind the HA login. No host ports are published.
ingress: true
ingress_port: 8099
panel_icon: mdi:alphabetical
panel_title: Spelling
panel_admin: false
# /share/spelling is the single source of truth (same files NGINX serves at http://spelling.home/).
map:
  - share:ro
backup: hot
watchdog: http://[HOST]:[PORT:8099]/healthz
options:
  root: /share/spelling
  index: spelling.html
schema:
  root: str
  index: str
